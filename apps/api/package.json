{
  "name": "@josam/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API. Scaffolded at PH-0.3.",
  "main": "./dist/main.js",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "probe:di": "node dist/probes/di.probe.js",
    "probe:prisma": "node -r dotenv/config dist/probes/prisma.probe.js",
    "start": "node -r dotenv/config dist/main.js",
    "db:seed": "node -r dotenv/config dist/shared/database/seeds/system-roles.seed.js"
  },
  "devDependencies": {
    "@josam/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1097.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sentry/node": "10.68.0",
    "dotenv": "17.2.4",
    "ioredis": "5.11.1",
    "jose": "6.2.4",
    "nodemailer": "9.0.3",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "prisma": "7.9.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ulid": "3.0.2",
    "zod": "4.4.3"
  }
}
