{
  "name": "josam-academy",
  "version": "0.0.0",
  "private": true,
  "description": "Josam Academy monorepo",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <25.0.0",
    "pnpm": ">=11.17.0 <12.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:css": "stylelint \"{apps,packages}/**/*.css\" --allow-empty-input",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "turbo run dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@josam/config": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "turbo": "2.10.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
