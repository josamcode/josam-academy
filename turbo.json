{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc", ".npmrc"],
  "tasks": {
    // Prisma's client is GENERATED, not published. `apps/api/src/generated/` is gitignored, so a
    // clean checkout has no PrismaClient type at all and every no-unsafe-* rule fires at once.
    // CI run #2 failed exactly this way (BR-1838).
    //
    // `postinstall` in apps/api is the PRIMARY mechanism: it makes "installed" imply "generated"
    // in every environment, including the paths that never touch turbo. This task closes a
    // second, narrower hole — a schema edited without a reinstall, where postinstall does not
    // re-run.
    //
    // It also makes turbo's cache honest. Turbo hashes git-tracked files, and this directory is
    // ignored, so deleting it changed no cache key: `pnpm lint` REPLAYED a green result against a
    // tree that could not lint. Declaring the output means turbo restores the client rather than
    // assuming it is present.
    "db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": []
    },
    // `env` is the ROOT CAUSE of CI being red for four consecutive tasks, and it is worth the
    // length because the failure was invisible from a developer machine.
    //
    // Turbo 2 runs tasks in STRICT env mode: a task receives only the variables declared here.
    // Undeclared ones are filtered out entirely — not merely excluded from the cache key.
    //
    // Locally that was undetectable. `apps/api/.env` exists and `vitest.setup.ts` loads
    // `dotenv/config`, so these values arrive INSIDE the vitest process from the file and never
    // pass through turbo at all. CI has no `.env`, so the same suites must read them from the
    // process environment — where turbo had already removed them. Every local gate passed while
    // CI failed, for four tasks, and nothing connected the two.
    //
    // Declaring them here also makes the cache honest: a changed DATABASE_URL now invalidates,
    // where before it could not, because turbo never saw it.
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "SMTP_HOST",
        "SMTP_PORT",
        "MAIL_FROM",
        "APP_URL"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
