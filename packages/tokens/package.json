{
  "name": "@josam/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design tokens \u2014 the single source for color, spacing, type, radius, motion (BR-1533). Built at PH-0.12.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/build-css.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@josam/config": "workspace:*",
    "@types/node": "24.13.3"
  }
}
