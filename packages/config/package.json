{
  "name": "@josam/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared build and tooling configuration: tsconfig presets (PH-0.1), ESLint / Stylelint / Prettier (PH-0.2).",
  "files": [
    "tsconfig",
    "eslint",
    "stylelint",
    "prettier"
  ],
  "exports": {
