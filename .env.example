# Copy to .env and fill in local values:  cp .env.example .env
#
# .env is gitignored. This file carries no real secret and never should — it documents the
# shape of the environment, not its contents.
#
# BR-1597 — local development never points at production services. Environment validation
# refuses production URLs when NODE_ENV=development.

NODE_ENV=development

# --- apps/api ---------------------------------------------------------------------------
PORT=4000

# --- docker compose ---------------------------------------------------------------------
# Consumed by docker-compose.yml. Every service binds to 127.0.0.1 only; changing these
# changes the host *port*, never the interface. There is no override that publishes to
# 0.0.0.0 and there should not be one.
#
# The defaults below are the ports documented in 13 §12. If one is already taken — a native
# PostgreSQL install owns 5432 on the founder's machine, for example — override it here rather
# than editing docker-compose.yml, and update DATABASE_URL / REDIS_URL to match. Docker fails
# loudly on a bound port, so a collision is never silent.
POSTGRES_USER=josam
POSTGRES_PASSWORD=josam_local_only
POSTGRES_DB=josam
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- consumed from PH-0.6 onward --------------------------------------------------------
# DATABASE_URL is read by Prisma at PH-0.6. It is listed here now because the credentials it
# is built from are set above; env.ts does not require it until PH-0.6 adds it to the schema.
DATABASE_URL=postgresql://josam:josam_local_only@127.0.0.1:5432/josam?schema=public
REDIS_URL=redis://127.0.0.1:6379

# --- observability (PH-0.19) --------------------------------------------------------------
# FEAT-217: production defaults to info. trace|debug|info|warn|error|fatal.
LOG_LEVEL=info

# Release tag, used on every log line and for Sentry grouping. Set from the image tag at PH-0.10.
APP_VERSION=0.0.0-dev

# Optional. With SENTRY_DSN unset the error tracker is inert and says so at boot — the exception
# filter behaves identically either way, the only difference is whether the report leaves the
# machine. Never commit a real DSN here.
# SENTRY_DSN=
